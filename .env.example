# Krishiayan local defaults. Copy to .env — never commit secrets.

APP_NAME=Krishiayan
APP_ENV=development
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# sqlite for laptop / tests; postgres for docker-compose
DATABASE_URL=sqlite:///./krishiayan.db
# DATABASE_URL=postgresql+psycopg://krishiayan:krishiayan@localhost:5433/krishiayan

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Open-Meteo is used by default (no key). Optional OpenWeatherMap overlay:
OPENWEATHER_API_KEY=
WEATHER_PROVIDER=open_meteo

# CORS for the Next.js farmer dashboard
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_LEVEL=INFO
MODEL_DIR=models/artifacts
SEED_DEMO=true
